+	bool torrent::forget_verified_pieces(std::vector<piece_index_t> const& pieces)
+	{
+		TORRENT_ASSERT(is_single_thread());
+		if (!valid_metadata() || !m_storage || m_seed_mode || m_abort
+			|| !is_downloading_state(m_state)) return false;
+		// Validate the whole batch before changing either the picker or peers.
+		std::set<piece_index_t> unique(pieces.begin(), pieces.end());
+		for (auto const p : unique)
+			if (p < piece_index_t(0) || p >= torrent_file().end_piece()
+				|| !have_piece(p)) return false;
+		if (unique.empty()) return true;
+		bool const was_finished = is_finished();
+		need_picker(true);
+		set_have_all(false);
+		for (auto const index : unique)
+		{
+			m_picker->set_piece_priority(index, dont_download);
+			m_picker->we_dont_have(index);
+			// Retire any unselected boundary slot behind the same disk fence.
+			m_ses.disk_thread().async_clear_piece(m_storage, index, [](piece_index_t) {});
+			inc_stats_counter(counters::num_have_pieces, -1);
+			for (auto* p : m_connections)
+			{
+				TORRENT_INCREMENT(m_iterating_connections);
+				p->reject_piece(index);
+				p->write_dont_have(index);
+			}
+		}
+		// Rebuild verified file accounting after withdrawing the shared pieces.
+		// The caller retains separate receipts for files verified before release.
+		m_file_progress.clear();
+		m_file_progress.init(*m_picker, torrent_file().files());
+		if (m_state == torrent_status::seeding) set_state(torrent_status::finished);
+		update_gauge();
+		update_peer_interest(was_finished);
+		update_want_peers();
+		update_state_timers();
+		set_need_save_resume(torrent_handle::if_download_progress);
+		state_updated();
+		return true;
+	}
