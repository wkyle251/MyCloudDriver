 #ifdef ENABLE_BITTORRENT
+std::unique_ptr<ValueBase> AddPeersRpcMethod::process(const RpcRequest& req,
+                                                    DownloadEngine* e)
+{
+  const auto gid = str2Gid(checkRequiredParam<String>(req, 0));
+  const auto entries = checkRequiredParam<List>(req, 1);
+  auto group = e->getRequestGroupMan()->findGroup(gid);
+  if (!group || entries->size() > 64 ||
+      group->getState() != RequestGroup::STATE_ACTIVE ||
+      group->isPauseRequested() || group->isHaltRequested()) {
+    throw DL_ABORT_EX("Peer hints require an active torrent and at most 64 peers");
+  }
+  auto btObject = e->getBtRegistry()->get(gid);
+  if (!btObject || !btObject->peerStorage) {
+    throw DL_ABORT_EX("The torrent is not ready for peer hints");
+  }
+  // Validate the complete request before adding anything. Numeric endpoints
+  // only: this authenticated method must not resolve names from a stale cache.
+  std::vector<std::shared_ptr<Peer>> peers;
+  for (const auto& value : *entries) {
+    const auto entry = downcast<Dict>(value);
+    const auto host = entry ? downcast<String>(entry->get("ip")) : nullptr;
+    const auto port = entry ? downcast<Integer>(entry->get("port")) : nullptr;
+    if (!host || host->s().size() > 45 || !util::isNumericHost(host->s()) ||
+        !port || port->i() < 1 || port->i() > 65535) {
+      throw DL_ABORT_EX("Invalid cached peer endpoint");
+    }
+    peers.push_back(std::make_shared<Peer>(host->s(), static_cast<uint16_t>(port->i())));
+  }
+  int64_t added = 0;
+  for (const auto& peer : peers) {
+    if (btObject->peerStorage->addPeer(peer)) { ++added; }
+  }
+  e->setRefreshInterval(std::chrono::milliseconds(0));
+  return Integer::g(added);
+}
