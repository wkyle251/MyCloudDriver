+std::unique_ptr<ValueBase> ReleaseFilesRpcMethod::process(const RpcRequest& req,
+                                                         DownloadEngine* e)
+{
+  const auto gid = str2Gid(checkRequiredParam<String>(req, 0));
+  const auto indexes = checkRequiredParam<List>(req, 1);
+  const auto root = checkRequiredParam<String>(req, 2)->s();
+  auto released = List::g();
+  auto group = e->getRequestGroupMan()->findGroup(gid);
+  if (!group || indexes->size() > 128) { throw DL_ABORT_EX("Invalid relay release request"); }
+  const auto& dctx = group->getDownloadContext();
+  const auto& ps = group->getPieceStorage();
+  if (!dctx->hasAttribute(CTX_ATTR_BT) || !ps || !ps->getDiskAdaptor() ||
+      group->getOption()->get(PREF_DIR) != root ||
+      group->getOption()->get(PREF_BT_METADATA_ONLY) == A2_V_TRUE) {
+    throw DL_ABORT_EX("Relay release requires the active torrent's payload directory");
+  }
+  if (group->getState() != RequestGroup::STATE_ACTIVE || group->isHaltRequested() ||
+      group->isPauseRequested()) { return std::move(released); }
+  auto checking = [&group](const CheckIntegrityEntry& ent) {
+    return ent.getRequestGroup() == group.get();
+  };
+  if (e->getCheckIntegrityMan() && (e->getCheckIntegrityMan()->isPicked(checking) ||
+                                   e->getCheckIntegrityMan()->isQueued(checking))) {
+    return std::move(released);
+  }
+  const auto& files = dctx->getFileEntries();
+  std::vector<size_t> requested;
+  for (const auto& value : *indexes) {
+    const auto index = downcast<Integer>(value);
+    if (!index || index->i() < 1 || static_cast<uint64_t>(index->i()) > files.size()) {
+      throw DL_ABORT_EX("Invalid relay file index");
+    }
+    requested.push_back(index->i() - 1);
+  }
+  BitfieldMan bf(dctx->getPieceLength(), dctx->getTotalLength());
+  bf.setBitfield(ps->getBitfield(), ps->getBitfieldLength());
+  const int64_t piece = dctx->getPieceLength();
+  for (auto index : requested) {
+    const auto& file = files[index];
+    auto complete = [&bf](const std::shared_ptr<FileEntry>& f) {
+      return bf.getOffsetCompletedLength(f->getOffset(), f->getLength()) == f->getLength();
+    };
+    // An unselected cloud-committed file may be only a boundary stub after
+    // restart. Its requested neighbours below still protect every live write.
+    if (file->isRequested() && !complete(file)) { continue; }
+    bool safe = true;
+    if (file->getLength() > 0) {
+      const auto first = file->getOffset() / piece * piece;
+      const auto last = (file->getOffset() + file->getLength() - 1) / piece * piece + piece;
+      auto neighbor = std::lower_bound(files.begin(), files.end(), first,
+          [](const std::shared_ptr<FileEntry>& f, int64_t offset) {
+            return f->getOffset() + f->getLength() <= offset;
+          });
+      for (; neighbor != files.end() && (*neighbor)->getOffset() < last; ++neighbor) {
+        if ((*neighbor)->isRequested() && !complete(*neighbor)) { safe = false; break; }
+      }
+    }
+    // A completed bit is set only after its verified write cache is flushed.
+    // Keep logical completion and selection: no pause, recheck or peer reset.
+    if (safe && ps->getDiskAdaptor()->releaseFile(index, root)) {
+      released->append(Integer::g(index + 1));
+    }
+  }
+  return std::move(released);
+}
