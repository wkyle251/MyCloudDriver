+bool MultiDiskAdaptor::canReadRange(int64_t offset, size_t length) const
+{
+  if (!releasedFiles_ || length == 0) { return true; }
+  auto first = findFirstDiskWriterEntry(diskWriterEntries_, offset);
+  const auto end = offset + length;
+  for (auto i = first; i != diskWriterEntries_.end(); ++i) {
+    const auto& file = (*i)->getFileEntry();
+    if (file->getOffset() >= end) { break; }
+    if ((*i)->isReleased() && file->getLength() > 0) { return false; }
+  }
+  return true;
+}
+
+bool MultiDiskAdaptor::releaseFile(size_t index, const std::string& root)
+{
+  if (index >= diskWriterEntries_.size() || root.empty() || root[0] != '/') {
+    return false;
+  }
+  auto* entry = diskWriterEntries_[index].get();
+  if (entry->isReleased()) { return true; } // Idempotent after a lost RPC reply.
+  auto prefix = root.back() == '/' ? root : root + '/';
+  const auto& path = entry->getFilePath();
+  if (path.compare(0, prefix.size(), prefix) != 0) { return false; }
+  auto relative = path.substr(prefix.size());
+  // Anchor unlinkat to the owned directory; never follow a payload symlink.
+  auto parent = ::open(root.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW);
+  if (parent < 0) { return false; }
+  size_t from = 0;
+  std::string leaf;
+  while (true) {
+    const auto slash = relative.find('/', from);
+    leaf = relative.substr(from, slash == std::string::npos ? slash : slash - from);
+    if (leaf.empty() || leaf == "." || leaf == "..") { ::close(parent); return false; }
+    if (slash == std::string::npos) { break; }
+    auto next = ::openat(parent, leaf.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW);
+    ::close(parent);
+    if (next < 0) { return false; }
+    parent = next;
+    from = slash + 1;
+  }
+  struct stat st;
+  if (::fstatat(parent, leaf.c_str(), &st, AT_SYMLINK_NOFOLLOW) != 0 || !S_ISREG(st.st_mode)) {
+    ::close(parent); return false;
+  }
+  // Close just this file, including mmap, so unlink actually returns its blocks.
+  auto opened = std::find(openedDiskWriterEntries_.begin(), openedDiskWriterEntries_.end(), entry);
+  if (opened != openedDiskWriterEntries_.end()) {
+    entry->closeFile();
+    openedDiskWriterEntries_.erase(opened);
+    if (getOpenedFileCounter()) { getOpenedFileCounter()->reduceNumOfOpenedFile(1); }
+  }
+  const auto removed = ::unlinkat(parent, leaf.c_str(), 0) == 0;
+  ::close(parent);
+  if (!removed) { return false; }
+  entry->setReleased();
+  releasedFiles_ = true;
+  return true;
+}
